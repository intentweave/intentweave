{
  "name": "@intentweave/cli",
  "version": "0.7.0",
  "description": "Command-line interface for IntentWeave \u2014 iw commands + MCP server",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "intentweave": "./dist/cli.js",
    "iw": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./context": {
      "types": "./dist/context/index.d.ts",
      "import": "./dist/context/index.js"
    },
    "./impact": {
      "types": "./dist/impact/index.d.ts",
      "import": "./dist/impact/index.js"
    },
    "./doc-health": {
      "types": "./dist/doc-health/index.d.ts",
      "import": "./dist/doc-health/index.js"
    },
    "./linker": {
      "types": "./dist/linker/index.d.ts",
      "import": "./dist/linker/index.js"
    },
    "./run-shared": {
      "types": "./dist/commands/run-shared.d.ts",
      "import": "./dist/commands/run-shared.js"
    },
    "./persist-neo4j": {
      "types": "./dist/commands/persist-neo4j.d.ts",
      "import": "./dist/commands/persist-neo4j.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "tsc",
    "test": "vitest run",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'TODO: eslint'",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@intentweave/analyzer": "workspace:*",
    "@intentweave/core": "workspace:*",
    "@intentweave/index": "workspace:*",
    "@intentweave/profiles": "workspace:*",
    "chalk": "^5.3.0",
    "chokidar": "^5.0.0",
    "commander": "^12.1.0",
    "glob": "^11.0.0",
    "minimatch": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "neo4j-driver": "^5.27.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "better-sqlite3": "^11.7.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "intentweave": {
    "tier": "oss",
    "description": "CLI and MCP server \u2014 open-source entry point for users"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/intentweave/intentweave.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
