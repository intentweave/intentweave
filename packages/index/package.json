{
  "name": "@intentweave/index",
  "version": "0.17.0",
  "description": "Code-aware retrieval index \u2014 SQLite-based index for agents and CI",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "tsc",
    "postbuild": "cp -r src/export/vendor dist/export/vendor",
    "test": "vitest run",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'TODO: eslint'",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@viz-js/viz": "^3.25.0",
    "@intentweave/sqlite-compat": "workspace:*",
    "minimatch": "^10.0.1",
    "@intentweave/cypher-lite": "workspace:*"
  },
  "peerDependencies": {
    "@intentweave/analyzer": "workspace:*",
    "@intentweave/core": "workspace:*"
  },
  "devDependencies": {
    "@intentweave/analyzer": "workspace:*",
    "@intentweave/core": "workspace:*",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "intentweave": {
    "tier": "oss",
    "description": "Code-aware retrieval index \u2014 lightweight SQLite backend for agents and CI"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/intentweave/intentweave.git",
    "directory": "packages/index"
  },
  "engines": {
    "node": ">=22.15.0"
  }
}
