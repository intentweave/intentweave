{
  "$schema": "intentweave://schemas/shapes/v1",
  "schemaVersion": "0.1",
  "shapes": [
    {
      "id": "planpling:Role",
      "kind": "ENTITY",
      "name": "Planpling Role",
      "description": "An IAM role in the planpling authorization system",
      "properties": {
        "roleId": { "type": "string", "required": true },
        "scope": { "type": "string", "required": true },
        "permissions": { "type": "array", "items": { "type": "string" } }
      }
    },
    {
      "id": "planpling:Permission",
      "kind": "ENTITY",
      "name": "Permission",
      "description": "A specific permission that can be granted",
      "properties": {
        "action": { "type": "string", "required": true },
        "resource": { "type": "string", "required": true }
      }
    },
    {
      "id": "planpling:grants",
      "kind": "RELATIONSHIP",
      "name": "Grants Permission",
      "description": "A role grants a specific permission",
      "source": "planpling:Role",
      "target": "planpling:Permission"
    },
    {
      "id": "planpling:inherits",
      "kind": "RELATIONSHIP",
      "name": "Inherits From",
      "description": "A role inherits permissions from another role",
      "source": "planpling:Role",
      "target": "planpling:Role"
    }
  ]
}
