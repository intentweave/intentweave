{
  "name": "@intentweave/server-open",
  "version": "0.14.0",
  "description": "IntentWeave open track routes — pipeline execution, KG query, context, impact analysis, doc-health, xlink",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "tsc",
    "test": "vitest run",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'TODO: eslint'",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@intentweave/core": "workspace:*",
    "@intentweave/server-core": "workspace:*",
    "@intentweave/analyzer": "workspace:*",
    "@intentweave/cli": "workspace:*",
    "@intentweave/profiles": "workspace:*",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.0.0",
    "neo4j-driver": "^5.27.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "intentweave": {
    "tier": "oss",
    "description": "Open track API routes — pipeline, query, context, impact, doc-health. Always open-source."
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/intentweave/intentweave.git",
    "directory": "packages/server-open"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
