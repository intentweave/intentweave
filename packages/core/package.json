{
  "name": "@intentweave/core",
  "version": "0.8.0",
  "description": "Core types, utilities, and interfaces for IntentWeave",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    },
    "./cgId": {
      "types": "./dist/cgId/index.d.ts",
      "import": "./dist/cgId/index.js"
    },
    "./predicates": {
      "types": "./dist/predicates/index.d.ts",
      "import": "./dist/predicates/index.js"
    },
    "./shapes": {
      "types": "./dist/shapes/index.d.ts",
      "import": "./dist/shapes/index.js"
    },
    "./workspace": {
      "types": "./dist/workspace/index.d.ts",
      "import": "./dist/workspace/index.js"
    },
    "./interfaces": {
      "types": "./dist/interfaces.d.ts",
      "import": "./dist/interfaces.js"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "import": "./dist/schemas/index.js"
    },
    "./schemas/*.json": {
      "import": "./schemas/*.json"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "tsc && cp -r schemas dist/",
    "test": "vitest run",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'TODO: eslint'",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "intentweave": {
    "tier": "oss",
    "description": "Core types, predicates, and interfaces \u2014 always open-source"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/intentweave/intentweave.git",
    "directory": "packages/core"
  }
}
