{
  "name": "@intentweave/core",
  "version": "0.1.0",
  "description": "Core types, utilities, and interfaces for IntentWeave",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
