{
  "name": "@intentweave/analyzer",
  "version": "0.6.0",
  "description": "Analysis engine for IntentWeave knowledge extraction — pipeline stages IN, FX, KX, GX",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mx": {
      "types": "./dist/mx/index.d.ts",
      "import": "./dist/mx/index.js"
    },
    "./linking": {
      "types": "./dist/linking/index.d.ts",
      "import": "./dist/linking/index.js"
    },
    "./validation": {
      "types": "./dist/validation/index.d.ts",
      "import": "./dist/validation/index.js"
    },
    "./transitions": {
      "types": "./dist/transitions/index.d.ts",
      "import": "./dist/transitions/index.js"
    },
    "./extractors": {
      "types": "./dist/extractors/index.d.ts",
      "import": "./dist/extractors/index.js"
    },
    "./llm": {
      "types": "./dist/providers/llm/index.d.ts",
      "import": "./dist/providers/llm/index.js"
    },
    "./viz": {
      "types": "./dist/viz/index.d.ts",
      "import": "./dist/viz/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "tsc",
    "test": "vitest run",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'TODO: eslint'",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@intentweave/ast-extractor": "workspace:*",
    "@intentweave/core": "workspace:*",
    "@intentweave/profiles": "workspace:*",
    "@intentweave/python-parser": "workspace:*",
    "@intentweave/swift-parser": "workspace:*",
    "beautiful-mermaid": "^1.1.3",
    "glob": "^10.3.0"
  },
  "peerDependencies": {
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "zod": "^3.23.8"
  },
  "intentweave": {
    "tier": "oss",
    "description": "Pipeline engine (IN→FX→KX→GX) — core extraction, must stay open-source"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/intentweave/intentweave.git",
    "directory": "packages/analyzer"
  }
}
