# IntentWeave Server — Environment Configuration
# Copy this file to .env and fill in your values.

# ── Neo4j ────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# ── Session & Workspace ─────────────────────────────────────────
# Default session for queries (overridable per-request via x-session-id header)
IW_SESSION=default

# Workspace root directory (absolute path).
# Required for run/persist endpoints. Leave blank to disable pipeline features.
# IW_WORKSPACE_ROOT=/path/to/your/project

# ── LLM (optional) ──────────────────────────────────────────────
# Enables natural-language query and topic-based context retrieval.
# Without these, only raw Cypher queries and entity/all context modes work.
# OPENAI_API_KEY=sk-...
# IW_LLM_MODEL=gpt-4o-mini

# ── Server ───────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# ── CORS ─────────────────────────────────────────────────────────
# Comma-separated origins, or * for all
CORS_ORIGIN=*

# ── Rate Limiting ────────────────────────────────────────────────
# Max requests per minute per IP (0 = disabled)
IW_RATE_LIMIT=60

# ── API Key Auth (optional) ─────────────────────────────────────
# When set, all /api/* requests require: Authorization: Bearer <key>
# Multiple keys separated by commas.
# IW_API_KEYS=
