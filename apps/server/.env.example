# IntentWeave Server — Environment Configuration
# Copy this file to .env and fill in your values.

# Neo4j connection
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Default session for queries
IW_SESSION=default

# Server
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# CORS (comma-separated origins, or * for all)
CORS_ORIGIN=*
